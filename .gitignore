# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
frontend/dist/
frontend/.vite/

# 环境与密钥
.env
.env.local
*.local

# 数据与产物: 景点原始数据与训练产物不入库(体量大且常带第三方许可)
data/
dataset/
# 例外: db/seed/data/ 是种子数据的**输入**, 要随仓库分发(来历见 db/seed/data/README.md)。
# 它不是上面说的那种原始数据 —— 只有名称 / 等级 / 省市 / 来源这些事实字段,
# 体量大、常带第三方许可的原始下载件(xlsx / html / 接口 JSON)不入库。
!db/seed/data/
recsys/output/
recsys/saved/
# RecBole 把日志写进 ./log 与 ./log_tensorboard(硬编码的 cwd 相对路径)。
# run_recbole.py 已经 chdir 到批次目录, 这里是保险第二道门。
/log/
/log_tensorboard/
/recsys/log/
/recsys/log_tensorboard/
*.sqlite
*.db

# AI 生成的待审草稿: 只留说明, 产物由人核对后抄进 seed.sql
db/seed/drafts/*.sql

# 上游基底缓存(由 scripts/fetch-bases.ps1 生成)
.cache/

# 中国 A 级景区名录的**过程文件**(原始下载件、含 CC BY-SA 的第三方条目、中间产物)。
# 进库用的规范化数据已经落在 db/seed/data/, 这里按 docs/LICENSE-AUDIT.md 第三节
# 「第三方数据不进代码仓库」的规矩隔离在仓库之外。
/景区名录/

# dev-up.ps1 的临时产物(日志与 pid)
.dev/

# make_installer.ps1 的产物(发给别人的 zip 与组装用的暂存目录)
/dist-installer/

# 编辑器
.vscode/
.idea/
.DS_Store
