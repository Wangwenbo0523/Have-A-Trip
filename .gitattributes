# 默认交给 git 判断, 仓库内存为 LF, 检出时按平台转换
* text=auto

# 明确文本类型, 避免在 Windows 上提交 CRLF
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.py      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.svg     text eol=lf
*.sql     text eol=lf

# 许可证与属性文件本身
LICENSE        text eol=lf
.gitattributes text eol=lf
# 无扩展名与点文件, 上面的 *.ext 规则盖不到
.gitignore     text eol=lf
.env.example   text eol=lf

# PowerShell 脚本在 Windows 上运行
*.ps1     text eol=crlf

# 二进制不做转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.ico     binary
*.gif     binary

# 语言统计排除基底与文档
frontend/src/**  linguist-vendored=false
docs/**          linguist-documentation
