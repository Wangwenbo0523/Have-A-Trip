# 复制为 .env 后按需修改。.env 已在 .gitignore 里, 不要提交。
#
# 生产目标是 PostgreSQL。测试默认走 SQLite 内存库, 不需要这个变量。
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/attraction_atlas

# 前端 dev server 的 origin, 逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 推荐接口里每个用户的缓存时长(秒)
REC_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------- AI / 大模型
#
# 默认 none: 什么都不配时应用照常跑; AI 入口(/api/v1/ai/status)显示为不可用,
# 「用一句话找景点」会退回关键词检索 —— 是降级, 不是报错。见 docs/PLAN.md 的 S9。
#
# provider 取值: none | ollama | deepseek | openai | custom
# 下面两种配法二选一, 都留注释就是不启用。

# --- 本地: 数据不出本机, 零成本, 不需要 key。先装 ollama 并 pull 过模型 ---
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b-instruct

# --- 云端: 需要 key。密钥只从环境变量来, 绝不写进仓库 ---
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 任何 OpenAI 兼容网关(自建 / 其他厂商)用 custom, 下面两项必须自己给
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-gateway.example.com/v1
# LLM_MODEL=your-model

# 调用超时(秒)。宁可降级成关键词检索, 也不让用户在页面上干等
LLM_TIMEOUT_SECONDS=20
# 每次请求的输出上限 —— 要的是几个查询条件, 不是文章
LLM_MAX_TOKENS=400
# 同一句话解析结果的缓存时长(秒), 0 表示不缓存
LLM_CACHE_TTL_SECONDS=300