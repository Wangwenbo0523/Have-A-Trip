# 复制为 .env 后按需修改。.env 已在 .gitignore 里, 不要提交。
#
# 生产目标是 PostgreSQL。测试默认走 SQLite 内存库, 不需要这个变量。
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/attraction_atlas

# 前端 dev server 的 origin, 逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 推荐接口里每个用户的缓存时长(秒)
REC_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------- AI / 大模型
#
# 默认 none: 什么都不配时应用照常跑; AI 入口(/api/v1/ai/status)显示为不可用,
# 「用一句话找景点」会退回关键词检索 —— 是降级, 不是报错。见 docs/PLAN.md 的 S9。
#
# provider 取值: none | ollama | deepseek | openai | custom
# 下面两种配法二选一, 都留注释就是不启用。

# --- 本地: 数据不出本机, 零成本, 不需要 key。先装 ollama 并 pull 过模型 ---
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b-instruct

# --- 云端: 需要 key。密钥只从环境变量来, 绝不写进仓库 ---
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 任何 OpenAI 兼容网关(自建 / 其他厂商)用 custom, 下面两项必须自己给
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-gateway.example.com/v1
# LLM_MODEL=your-model

# 调用超时(秒)。宁可降级成关键词检索, 也不让用户在页面上干等
LLM_TIMEOUT_SECONDS=20
# 每次请求的输出上限 —— 要的是几个查询条件, 不是文章
LLM_MAX_TOKENS=400
# 同一句话解析结果的缓存时长(秒), 0 表示不缓存
LLM_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------ AI / 向量检索
#
# 语义检索(把一句话向量化, 与景点描述的向量比相似度)用。与对话模型分开配置:
# 摘要模型与向量模型常常不是同一家。
#
# 默认 inherit: 跟随 LLM_PROVIDER。只配了 LLM_* 的部署不用再看这一节。
# 取值: inherit | none | ollama | deepseek | openai | custom
#
# 注意 deepseek 预设没有向量模型 —— 那边只有对话接口。用 deepseek 时要单独指一家:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=sk-xxxxxxxx

# --- 本地: 与 ollama 预设配套, 需要先 ollama pull nomic-embed-text ---
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-m3

# 任何 OpenAI 兼容网关用 custom, 下面两项必须自己给
# EMBEDDING_PROVIDER=custom
# EMBEDDING_BASE_URL=https://your-gateway.example.com/v1
# EMBEDDING_MODEL=your-embedding-model
# EMBEDDING_API_KEY=sk-xxxxxxxx

# 0 = 自动: 以服务商返回的维度为准, 并写进 attraction_embedding.dim。
# 给正数则强校验, 不符直接报错 —— 想锁死维度时用。
EMBEDDING_DIM=0
# 一次请求塞多少条文本。批次太大有的网关会回 413
EMBEDDING_BATCH_SIZE=16
# 同一段文本的向量缓存时长(秒), 0 表示不缓存
EMBEDDING_CACHE_TTL_SECONDS=300

# 语义检索默认返回条数与上限
SEMANTIC_DEFAULT_LIMIT=10
SEMANTIC_MAX_LIMIT=50
# 混合相似度里向量分与结构化分的权重(两者都会归一化到 0..1)
SEMANTIC_VECTOR_WEIGHT=0.7
SEMANTIC_STRUCTURED_WEIGHT=0.3

# ---------------------------------------------------------------- 行程生成
#
# 行程是第一个按次计费的能力, 所以限额与预算不是可选项。
# 灌向量: python scripts/build_embeddings.py

# 每个 owner(登录用户按用户, 匿名按设备)每天能提交几次。0 表示不限(只建议本地)
TRIP_DAILY_LIMIT=5
# 全站合计每天能烧多少 token, 超了新请求直接拒。0 表示不限
TRIP_GLOBAL_DAILY_TOKEN_BUDGET=200000
# 交给模型的候选景点条数。这是成本的主要旋钮
TRIP_CANDIDATE_LIMIT=40
# 每天最多几站; 生成时的输出上限与调用超时
TRIP_MAX_ITEMS_PER_DAY=6
TRIP_MAX_TOKENS=2000
TRIP_TIMEOUT_SECONDS=60
# 前端轮询上限(秒)。写进响应, 前端据此停轮询
TRIP_POLL_MAX_SECONDS=90
# generating 超过这么久没心跳视为进程已死, 可被回收
TRIP_STALE_AFTER_SECONDS=180

# ------------------------------------------------------- 按位置推荐(首页「出去走走」)
#
# 首页那块弹窗按 IP 猜你在哪个城市, 把同城/同省的景点排在前面 —— 只到城市级, 不是定位:
# 位置只用于这一次查询, 不落库、不写 cookie、不返回坐标。
#
# 默认 none: 不配就一个外部请求都不发, /api/v1/attractions/nearby 直接退回全国随机并在
# 响应里标 scope=nation。与 LLM_PROVIDER 同一思路 —— 不配就不连外网。
# 取值: none | ipapi | custom
GEO_IP_PROVIDER=none

# --- 开箱可用的一种: ip-api 免费档(45 次/分钟, 只提供 http) ---
# 它会按 lang=zh-CN 返回中文城市名, 但写法与库里的「杭州市」不一定一致, 所以后端做的是
# 归一化后相等匹配, 对不上就逐级下降(城市 -> 省份 -> 全国), 绝不拿 LIKE 硬凑。
# GEO_IP_PROVIDER=ipapi

# --- 自建或别家: custom 必须给地址。地址里有 {ip} 就替换, 没有就拼在路径末尾 ---
# 返回值字段名固定为 city / regionName(或 region) / countryCode。
# GEO_IP_PROVIDER=custom
# GEO_IP_BASE_URL=https://geo.example.com/json/{ip}
# 需要鉴权的服务会带成 Authorization: Bearer <key>
# GEO_IP_API_KEY=xxxxxxxx

# 认位置是首页的锦上添花: 宁可超时退回随机, 也不让它拖慢首页
GEO_IP_TIMEOUT_SECONDS=1.5
# 反代后面才打开。默认不信 X-Forwarded-For —— 那个头谁都能写, 信了就等于让伪造的头把
# 所有人指到同一个城市。打开时请确认代理是覆盖而不是追加这个头。
GEO_TRUST_FORWARDED_FOR=false

# ------------------------------------------------------------- 静态站点(单进程形态)
#
# 本机应用 / 不需要反向代理的单机部署: 让这个 API 进程自己托 frontend/dist, 界面与 /api
# 同源同端口。默认关闭 —— 不设就等于以前的行为(根路径返回 API 自述 JSON)。
#
# 开了之后: api/ 、docs 、openapi.json 、redoc 前缀先判, 其余未知路径回落 index.html;
# 拼出来的文件路径必须仍落在 dist 里(../ 一律挡掉); /assets/** 长缓存, index.html no-store。
# 仓库里 Windows 那条本机应用路径(damo.cmd / scripts/damo-app.ps1)走的就是这个形态。
SERVE_FRONTEND=false

# 前端产物目录, 只在 SERVE_FRONTEND=true 时有意义。留空按仓库位置算(<仓库>/frontend/dist),
# 与进程 cwd 无关。
# FRONTEND_DIST=C:\path\to\damo\frontend\dist
